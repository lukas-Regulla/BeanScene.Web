@model IEnumerable<BeanScene.Web.Models.Reservation>

@{
    ViewData["Title"] = "Reservations";
}

<h1 class="page-title">Reservations</h1>

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm mb-3">+ New Reservation</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstName)</th>
            <th>@Html.DisplayNameFor(model => model.LastName)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.Phone)</th>
            <th>@Html.DisplayNameFor(model => model.StartTime)</th>
            <th>@Html.DisplayNameFor(model => model.Duration)</th>
            <th>@Html.DisplayNameFor(model => model.NumOfGuests)</th>
            <th>@Html.DisplayNameFor(model => model.ReservationSource)</th>
            <th>@Html.DisplayNameFor(model => model.Notes)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
            <th>@Html.DisplayNameFor(model => model.Sitting)</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                <td>@Html.DisplayFor(modelItem => item.StartTime)</td>
                <td>@Html.DisplayFor(modelItem => item.Duration)</td>
                <td>@Html.DisplayFor(modelItem => item.NumOfGuests)</td>
                <td>@Html.DisplayFor(modelItem => item.ReservationSource)</td>
                <td>@Html.DisplayFor(modelItem => item.Notes)</td>
                <td>
                    <span class="status-badge status-@item.Status.ToString().ToLower()">
                        @item.Status
                    </span>
                </td>
                <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                <td>@Html.DisplayFor(modelItem => item.Sitting.Stype)</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-primary btn-sm dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            Actions
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item"
                                   asp-action="Edit"
                                   asp-route-id="@item.ReservationId">
                                    Edit
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-action="Details"
                                   asp-route-id="@item.ReservationId">
                                    Details
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-action="Delete"
                                   asp-route-id="@item.ReservationId">
                                    Delete
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-action="AssignTables"
                                       asp-route-id="@item.ReservationId">
                                        Assign Tables
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
