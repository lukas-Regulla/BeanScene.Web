@model IEnumerable<BeanScene.Web.Models.Reservation>

<h2 class="page-title mt-3">My Reservations</h2>

<table class="table mt-4">
    <thead>
        <tr>
            <th>Date</th>
            <th>Guests</th>
            <th>Duration (mins)</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.StartTime.ToString("dddd, dd MMM yyyy hh:mm tt")</td>
                <td>@r.NumOfGuests</td>
                <td>@r.Duration</td>
                <td>
                    <span class="status-badge status-@(r.Status?.ToLower() ?? "")">
                        @r.Status
                    </span>
                </td>
                <td>
                    @if (r.Status == "Pending")
                    {
                        <a asp-action="Edit"
                           asp-route-id="@r.ReservationId"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>
                    }
                    else
                    {
                        <span class="muted">Confirmed</span>
                    }
                    <form asp-action="Delete" asp-route-id="@r.ReservationId" method="post" style="display:inline;">
                        <button type="submit"
                                class="btn btn-danger btn-sm"
                                onclick="return confirm('Cancel this reservation?');">
                            Cancel
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        ← Back to Home
    </a>
</div>
