@model IEnumerable<BeanScene.Web.Models.SittingSchedule>

@{
    ViewData["Title"] = "Index";
}

<h1>Sitting Schedule</h1>

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm"> Create New Sitting</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Stype)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDateTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Scapacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Stype)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDateTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDateTime)
            </td>
            <td>
                @item.Reservations.Sum(r => r.NumOfGuests) / @item.Scapacity
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-primary btn-sm dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            Actions
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item"
                                   asp-action="Edit"
                                   asp-route-id="@item.SittingScheduleId">
                                    Edit
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-action="Details"
                                   asp-route-id="@item.SittingScheduleId">
                                    Details
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-action="Delete"
                                   asp-route-id="@item.SittingScheduleId">
                                    Delete
                                </a>
                            </li> 
                        </ul>
                    </div>
                </td>
        </tr>
}
    </tbody>
</table>
