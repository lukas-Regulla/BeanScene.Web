@model IEnumerable<BeanScene.Web.Models.RestaurantTable>

@{
    ViewData["Title"] = "Index";
}

<h1>Tables</h1>

<p>
    <a asp-action="Create" class="btn btn-primary btn-=lg">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TableName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Seats)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Area)
            </th>
            <th class =" text-end" width="250" > </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TableName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Seats)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Area.AreaName)
            </td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-primary btn-sm dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            Actions
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item"
                                   asp-action="Edit"
                                   asp-route-id="@item.RestaurantTableId">
                                    Edit
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-action="Details"
                                   asp-route-id="@item.RestaurantTableId">
                                    Details
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-action="Delete"
                                   asp-route-id="@item.RestaurantTableId">
                                    Delete
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>
        </tr>
}
    </tbody>
</table>
